{
  "model": {
    "type": "condition",
    "property": "has_component",
    "component": "custom_name",
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "minecraft:custom_name",
      "cases": [
        {
          "when": "Holy GS Mace",
          "model": {
            "type": "model",
            "model": "item/mace/holy_gs_mace"
          }
        },
        {
          "when": "Big Joe",
          "model": {
            "type": "model",
            "model": "item/mace/big_joe"
          }
        },
        {
          "when": "Blastbreaker Mace",
          "model": {
            "type": "model",
            "model": "item/mace/blastbreaker_mace"
          }
        },
        {
          "when": "Bowling Pin",
          "model": {
            "type": "model",
            "model": "item/mace/bowling_pin"
          }
        },
        {
          "when": "Frying Pan",
          "model": {
            "type": "model",
            "model": "item/mace/frying_pan"
          }
        },
        {
          "when": "Ban Hammer",
          "model": {
            "type": "model",
            "model": "item/mace/ban_hammer"
          }
        }
      ],
      "fallback": {
        "type": "model",
        "model": "minecraft:item/mace"
      }
    },
    "on_false": {
      "type": "model",
      "model": "minecraft:item/mace"
    }
  }
}