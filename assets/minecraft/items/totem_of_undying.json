{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:has_component",
    "component": "minecraft:custom_name",
    "on_true": {
      "type": "minecraft:select",
      "model": "minecraft:item/totem_of_undying",
      "property": "minecraft:component",
      "component": "minecraft:custom_name",
      "cases": [
        {
          "when": "Lenin",
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/2d/lenin"
          }
        },
        {
          "when": "Cutie",
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/cutie"
          }
        },
        {
          "when": "Box Gloves",
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/boxgloves"
          }
        },
        {
          "when": "Allay Maid",
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/allay_maid"
          }
        },
        {
          "when": "Thicc Totem",
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/thicc_totem"
          }
        },
        {
          "when": "Hi Frequency Katana Holster",
          "model": {
            "type": "minecraft:condition",
            "property": "minecraft:keybind_down",
            "keybind": "key.attack",
            "on_true": {
              "type": "minecraft:model",
              "model": "item/netherite_sword/hi_frequency_katana_holster"
            },
            "on_false": {
              "type": "minecraft:model",
              "model": "item/netherite_sword/hi_frequency_katana_in_holster"
            }
          }
        },
        {
          "when": "Empty",
          "model": {
            "type": "minecraft:empty"
          }
        },
        {
          "when": "Morphine Syringe",
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/morphine_syringe"
          }
        },
        {
          "when": "Ring",
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/ring"
          }
        },
        {
          "when": "Bandage Blue",
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/bandage_blue"
          }
        },
        {
          "when": "Bandage Red",
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/bandage_red"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/totem_of_undying"
      }
    },
    "on_false": {
      "type": "minecraft:model",
      "model": "minecraft:item/totem_of_undying"
    }
  }
}